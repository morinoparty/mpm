{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "mpm-repo",
    // Workerスクリプトは持たず、public/ を静的アセットとしてそのまま配信する。
    // index.json（scripts/build.ts が生成）と plugins/*.json、schema/*.json が配信対象。
    "compatibility_date": "2025-10-17",
    "routes": [
        {
            "pattern": "repo.mpm.nikomaru.dev",
            "custom_domain": true
        }
    ],
    "assets": {
        "directory": "./public"
    }
}
