    "AdvancedPortals": {
      "id": "AdvancedPortals",
      "website": "https://modrinth.com/plugin/advanced-portals",
      "license": "LGPL-3.0-only",
      "repositories": [
        {
          "type": "modrinth",
          "id": "axTqSWQA",
          "versionModifier": "(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)",
          "latest": {
            "versionMatcher": "^\\d+(\\.\\d+)*-[Ss]pigot$",
            "versionModifier": "(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)"
          },
          "beta": {
            "versionMatcher": "(?i)legacy-?spigot$",
            "versionModifier": "(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)"
          }
        }
      ]
    },
